# ---- lgu-ecosystem:start ----
# LGU Ecosystem — See ../CLAUDE.md for the full ecosystem overview.
#
# Dev↔Prod parity rule: dev and prod configs MUST differ only in DNS
# hostnames, secrets, and APP_ENV/NODE_ENV/APP_DEBUG. If you find yourself
# diverging anything else between environments, stop and re-read the rule.
#
# Two SSO hosts, two purposes:
#   - Login redirect: sso-portal.local (dev) / sso-portal.lguquezon.local (prod)
#   - SSO API:        api.sso.local    (dev) / api.sso.lguquezon.local    (prod)
# Never sso-ui.*, never lgu-sso.test, never lgu-sso.local.
# ---- lgu-ecosystem:end ----

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket server for real-time notifications)
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OPTS Configuration
OPTS_IDLE_THRESHOLD_DAYS=2

# ---- lgu-ecosystem-sso:start ----
# SSO Integration (consumer side). See ../CLAUDE.md → Authentication Model.
# Parity rule: cookie name/domain/flags MUST match LGU-SSO server exactly.
# Local Docker uses the trusted *.lgu.lan certificate. Production hosts
# must share one operator-owned parent domain with a trusted certificate.

# User-facing login redirect (browser goes here)
SSO_PORTAL_URL=https://sso-portal.lgu.lan
# Prod: SSO_PORTAL_URL=https://sso-portal.<trusted-parent-domain>

# Server-to-server SSO API (token validate, /auth/me, etc.)
SSO_API_URL=http://lgu-sso:8000
# OPTS appends /api/v1 itself. Prod: use the private backend URL on the Docker network.

# OAuth client credentials — register this app in LGU-SSO Admin to get these
SSO_CLIENT_ID=your-app-id-here
SSO_CLIENT_SECRET=your-app-secret-here

# Callback URL in THIS app that LGU-SSO redirects to after login
SSO_REDIRECT_URI=https://opts.lgu.lan/auth/sso/callback
# Prod: SSO_REDIRECT_URI=https://opts.<trusted-parent-domain>/auth/sso/callback

# Shared SSO cookie — names/flags MUST match LGU-SSO server
SSO_COOKIE_NAME=lgu_sso_token
SSO_COOKIE_DOMAIN=.lgu.lan
# Prod: SSO_COOKIE_DOMAIN=.<trusted-parent-domain>
SSO_COOKIE_SAME_SITE=lax
SSO_COOKIE_SECURE=true

# Legacy variable names kept as aliases — code today reads these. Rename is
# tracked under root CLAUDE.md Open Issue #2 (purge legacy hostnames).
# TODO: migrate code to read SSO_PORTAL_URL and remove SSO_UI_URL.
SSO_UI_URL=https://sso-portal.lgu.lan
# Prod: SSO_UI_URL=https://sso-portal.<trusted-parent-domain>
# ---- lgu-ecosystem-sso:end ----

# Docker Database Configuration
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=opts2026
# DB_USERNAME=opts
# DB_PASSWORD=secret

# Optional LGU Connect widget; production preparation remains disabled.
CONNECT_PILOT_ENABLED=false
CONNECT_PILOT_ORIGIN=
CONNECT_PILOT_HOST_ID=
CONNECT_PILOT_KEY_ID=
CONNECT_PILOT_SECRET=
CONNECT_PILOT_INTROSPECTION_SOURCE_PER_MINUTE=6000
CONNECT_PILOT_INTROSPECTION_BINDING_PER_MINUTE=120

APP_NAME="EDTS 2027 Staging"
APP_KEY=
LOG_CHANNEL=stderr
DB_DATABASE=edts_staging
DB_USERNAME=edts_staging
DB_PASSWORD=
# Exact reverse proxy address/CIDR on the staging ingress network; never wildcard.
TRUSTED_PROXIES=
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=edts-staging
REVERB_APP_KEY=
REVERB_APP_SECRET=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
CONNECT_PILOT_ENABLED=false
CONNECT_PILOT_ORIGIN=https://staging.connect.lguquezon.local
CONNECT_PILOT_HOST_ID=edts-staging
CONNECT_PILOT_KEY_ID=edts-staging-key
CONNECT_PILOT_SECRET=
CONNECT_PILOT_INTROSPECTION_SOURCE_PER_MINUTE=6000
CONNECT_PILOT_INTROSPECTION_BINDING_PER_MINUTE=120

# Fill in the exact EDTS staging host and its existing staging SSO client.
# Keep disabled until trusted TLS, host registration, keys and grants are ready.
APP_ENV=staging
APP_URL=
CONNECT_PILOT_ENABLED=false
CONNECT_PILOT_ORIGIN=https://staging.connect.lguquezon.local
CONNECT_PILOT_HOST_ID=
CONNECT_PILOT_KEY_ID=
CONNECT_PILOT_SECRET=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
CACHE_STORE=database
SSO_API_URL=https://staging.api.sso.lguquezon.local
SSO_UI_URL=https://staging.sso.lguquezon.local
SSO_REDIRECT_URI=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

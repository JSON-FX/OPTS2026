# Preparation only. Proposed host/key IDs must match the private Connect registration.
# Merge the CONNECT_PILOT_* values into the existing private runtime.env after review.
# Keep the widget and Connect host/key disabled until functional and capacity acceptance.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.opts.lguquezon.local
CONNECT_PILOT_ENABLED=false
CONNECT_PILOT_ORIGIN=https://staging.connect.lguquezon.local
CONNECT_PILOT_HOST_ID=opts-staging
CONNECT_PILOT_KEY_ID=opts-staging-v1
CONNECT_PILOT_SECRET=
# Baseline guardrails only; these values do not certify 300–500 concurrent users.
CONNECT_PILOT_INTROSPECTION_SOURCE_PER_MINUTE=6000
CONNECT_PILOT_INTROSPECTION_BINDING_PER_MINUTE=120
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
CACHE_STORE=database
SSO_API_URL=https://staging.api.sso.lguquezon.local
SSO_UI_URL=https://staging.sso.lguquezon.local
SSO_REDIRECT_URI=https://staging.opts.lguquezon.local/auth/sso/callback
# Retain this environment's existing private SSO credentials; do not copy this file wholesale.

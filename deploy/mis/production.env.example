APP_NAME="OPTS"
APP_KEY=<generate-a-separate-base64-key>
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_DATABASE=opts
DB_USERNAME=opts
DB_PASSWORD=<unique-database-password>
